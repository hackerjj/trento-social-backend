APP_NAME="Trento Social"
APP_ENV=local
# Generar con: php artisan key:generate --show
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:10000

# MongoDB (MISMO cluster que Sushi; aislamiento por colecciones trento_*)
DB_CONNECTION=mongodb
MONGO_URI=
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=sushi_queen
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin

# Redis (MISMO servidor que Sushi; aislamiento por prefijo trento:)
REDIS_CLIENT=predis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=0
REDIS_SESSION_DB=0
# Prefijo de cliente para las claves de framework (cache/rate-limit) de Trento.
REDIS_PREFIX=trento:

# Cache (usar "redis" en produccion para contadores y rate limiting compartido)
CACHE_DRIVER=redis
CACHE_PREFIX=trento_cache_

# Sesion y colas
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Logging (usar "json" en produccion para logs estructurados)
LOG_CHANNEL=json

# JWT (no se usa login JWT; tymon/jwt-auth esta por paridad con Sushi)
JWT_SECRET=
JWT_TTL=60

# CORS (lista separada por comas de origenes permitidos)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Token de administrador para los endpoints protegidos (/api/trento/registros, /links, stats)
TRENTO_ADMIN_TOKEN=

# Geolocalizacion por IP del acortador (best-effort, no bloqueante)
# Valores: ipwhois (HTTPS, gratis, sin key) | ip-api (HTTP plano) | none (desactiva)
GEO_PROVIDER=ipwhois
GEO_TIMEOUT_MS=800

# Puerto del servicio (Render espera 10000)
PORT=10000
